# Plantilla de variables de entorno - Analytics TMS
# Copiar a .env y reemplazar los valores <CHANGE_ME>. NUNCA versionar .env.

# --- Oracle Database ---
# Contraseña del usuario administrador (SYS/SYSTEM) del contenedor oracle-dw
ORACLE_PWD=<CHANGE_ME>
# DSN de conexión (formato host:puerto/servicio). Dev: Oracle Free; Prod: instancia corporativa
ORACLE_DSN=oracle-dw:1521/FREEPDB1

# Contraseñas de usuarios de aplicación (mínimo privilegio)
# BI_READER: SELECT sobre BI_SEMANTIC y DWH_MART (usado por Superset)
BI_READER_PWD=<CHANGE_ME>
# SIM_WRITER: INSERT/UPDATE sobre STG_SRC (usado por data-simulator)
SIM_WRITER_PWD=<CHANGE_ME>
# ETL_RUNNER: usado por dbt-oracle en el contenedor etl-runner
ETL_RUNNER_PWD=<CHANGE_ME>

# --- PostgreSQL (metastore de Superset) ---
POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=<CHANGE_ME>

# --- Valkey (caché y broker Celery de Superset) ---
VALKEY_HOST=superset-valkey
VALKEY_PORT=6379

# --- Apache Superset ---
# Generar con: openssl rand -base64 42
SUPERSET_SECRET_KEY=<CHANGE_ME>
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=<CHANGE_ME>
